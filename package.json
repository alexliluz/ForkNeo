{
  "name": "forkneo",
  "version": "0.2.0",
  "description": "Convert GitHub forks into independent repositories while preserving Git history.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexliluz/ForkNeo.git"
  },
  "homepage": "https://github.com/alexliluz/ForkNeo",
  "bugs": {
    "url": "https://github.com/alexliluz/ForkNeo/issues"
  },
  "keywords": [
    "github",
    "fork",
    "migration",
    "git",
    "cli",
    "typescript"
  ],
  "bin": {
    "forkneo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "inquirer": "^14.0.2",
    "ora": "^9.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
